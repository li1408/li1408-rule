---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import dayjs from "dayjs";
import createSlug from "../lib/createSlug";

interface Props {
  posts: CollectionEntry<"blog">[];
  variant?: "compact" | "feed";
}

const { posts, variant = "feed" } = Astro.props;
const orderedPosts = [...posts].sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const heroImage = orderedPosts.at(-1)?.data.heroImage ?? "/math-workflow-repro-hero.webp";
const articleCount = orderedPosts.length;
---

{
  articleCount > 0 && (
    <details
      class:list={[
        "group bg-base-100",
        variant === "feed" &&
          "overflow-hidden rounded-lg transition ease-in-out hover:shadow-xl open:shadow-sm",
        variant === "compact" && "mx-4 mb-4 border-l-2 border-base-300 pl-4",
      ]}
      data-workflow-collection
      data-workflow-variant={variant}
    >
      <summary
        class:list={[
          "cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden",
          variant === "feed" && "rounded-lg",
          variant === "compact" && "py-3",
        ]}
      >
        {variant === "feed" ? (
          <span class="hero-content flex-col md:flex-row">
            <Image
              src={heroImage}
              width={750}
              height={422}
              format="webp"
              alt="数学建模工作流集合"
              class="max-w-full rounded-lg md:max-w-[13rem]"
            />
            <span class="w-full min-w-0 grow">
              <span class="flex flex-wrap items-center gap-2">
                <span class="text-xl font-bold">数学建模工作流</span>
                <span class="badge badge-secondary">{articleCount} 篇合集</span>
              </span>
              <span class="block py-1">
                从搭建工作台、补齐证据链，到独立复现和 CUMCM C 题实战。这不是四篇重复文章，而是一条逐步加固的过程记录。
              </span>
              <span class="mt-3 block text-right text-sm font-medium">
                <span class="group-open:hidden">展开时间线</span>
                <span class="hidden group-open:inline">收起时间线</span>
              </span>
            </span>
          </span>
        ) : (
          <span class="flex min-w-0 items-center justify-between gap-4 pr-2">
            <span class="min-w-0">
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-bold">数学建模工作流</span>
                <span class="badge badge-outline badge-sm">{articleCount} 篇</span>
              </span>
              <span class="mt-1 block text-sm text-base-content/70">从搭工作台到 C 题实战，点击展开完整过程。</span>
            </span>
            <span class="shrink-0 text-sm font-medium group-open:hidden">展开</span>
            <span class="hidden shrink-0 text-sm font-medium group-open:inline">收起</span>
          </span>
        )}
      </summary>

      <div
        class:list={[
          "border-t border-base-300",
          variant === "feed" ? "px-5 pb-5 pt-4 md:px-8" : "pb-2 pl-1 pr-2 pt-4",
        ]}
      >
        <ol class="relative ml-2 border-l border-base-300">
          {orderedPosts.map((post, index) => (
            <li class="relative pb-6 pl-6 last:pb-1" data-workflow-series-entry>
              <span
                class="absolute -left-[5px] top-2 h-2 w-2 rounded-full bg-base-content"
                aria-hidden="true"
              />
              <div class="mb-1 flex flex-wrap items-center gap-2">
                <span class="badge badge-outline badge-sm">阶段 {index + 1}</span>
                <time class="text-sm text-base-content/60">
                  {dayjs(post.data.pubDate).format("YYYY.MM.DD")}
                </time>
              </div>
              <a
                href={`/blog/${createSlug(post.data.title, post.slug)}`}
                class="font-bold leading-snug hover:underline"
                data-astro-prefetch="viewport"
              >
                {post.data.title}
              </a>
              <p class="mt-1 text-sm leading-relaxed text-base-content/75">{post.data.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </details>
  )
}
